{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jetpen/review-brief/docs/specs/review-brief.schema.json",
  "title": "Review Brief",
  "type": "object",
  "required": ["metadata", "target", "objective", "index"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "target": { "$ref": "#/$defs/target" },
    "objective": { "type": "string", "minLength": 1 },
    "index": {
      "type": "array",
      "items": { "$ref": "#/$defs/indexEntry" }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summaries": { "type": "array", "items": { "$ref": "#/$defs/summary" } },
    "explanations": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/annotation" } },
    "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
  },
  "additionalProperties": true,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["brief_id", "title", "schema_version", "generator"],
      "properties": {
        "brief_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "generator": {
          "type": "object",
          "required": ["name", "version", "invocation_id", "generated_at"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "invocation_id": { "type": "string", "minLength": 1 },
            "generated_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "repository_locator"],
          "properties": {
            "kind": { "const": "repository" },
            "repository_locator": { "type": "string", "minLength": 1 },
            "branch": { "type": "string" },
            "revision": { "type": "string" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "repository_locator", "base_revision", "head_revision"],
          "properties": {
            "kind": { "const": "pull_merge_request" },
            "repository_locator": { "type": "string", "minLength": 1 },
            "request_id": {},
            "base_revision": { "type": "string", "minLength": 1 },
            "head_revision": { "type": "string", "minLength": 1 },
            "changed_scope": { "type": "object" }
          },
          "additionalProperties": true
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["id", "link"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "link": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "locator": {}
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "indexEntry": {
      "type": "object",
      "required": ["id", "target", "category", "priority", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["finding", "verification", "risk", "uncertainty", "background", "direct_evidence"]
        },
        "priority": { "type": ["number", "string"] },
        "label": { "type": "string", "minLength": 1 },
        "review_instruction": { "type": "string" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      },
      "additionalProperties": true
    },
    "explanation": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "confidence": { "type": "object" }
      },
      "additionalProperties": true
    },
    "diagram": {
      "type": "object",
      "required": ["id", "type", "title", "representation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "representation": {},
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "rendering": { "type": "object" }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      },
      "additionalProperties": true
    }
  }
}
